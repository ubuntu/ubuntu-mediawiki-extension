{
    "name": "ubuntu/mediawiki-ubuntu-extension",
    "type": "mediawiki-extension",
    "description": "Shared resources and integrations for the Ubuntu Wiki.",
    "keywords": [
        "wiki",
        "MediaWiki",
        "extension",
        "Ubuntu"
    ],
    "license": "GPL-3.0",
    "authors": [
        {
            "name": "Ubuntu Developers"
        }
    ],
    "support": {
        "source": "https://github.com/ubuntu/ubuntu-mediawiki-extension"
    },
    "require": {
        "composer/installers": ">1.0.12"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "installer-name": "UbuntuWiki"
    },
    "require-dev": {
        "mediawiki/mediawiki-codesniffer": "52.0.1",
        "mediawiki/mediawiki-phan-config": "0.20.0",
        "mediawiki/minus-x": "2.0.1",
        "php-parallel-lint/php-console-highlighter": "1.0.0",
        "php-parallel-lint/php-parallel-lint": "1.4.0"
    },
    "scripts": {
        "fix": [
            "minus-x fix .",
            "phpcbf"
        ],
        "test": [
            "parallel-lint . --exclude node_modules --exclude vendor",
            "@phpcs",
            "minus-x check ."
        ],
        "phan": "phan -d . --long-progress-bar",
        "phpcs": "phpcs -sp --cache"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
