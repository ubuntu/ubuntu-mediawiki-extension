{
    "extends": [
        "stylelint-config-wikimedia/support-modern",
        "stylelint-config-wikimedia/mediawiki"
    ],
    "reportNeedlessDisables": true,
    "rules": {
        "declaration-no-important": null,
        "declaration-property-unit-disallowed-list": null,
        "no-descending-specificity": null,
        "plugin/no-unsupported-browser-features": [
            true,
            {
                "browsers": [
                    "extends browserslist-config-wikimedia/modern",
                    "not Safari < 16",
                    "not ios_saf < 16"
                ],
                "severity": "warning",
                "ignore": [
                    "mdn-text-decoration-shorthand",
                    "text-decoration"
                ],
                "ignorePartialSupport": true
            }
        ],
        "selector-class-pattern": null,
        "selector-max-id": null,
        "selector-max-specificity": "1,4,2"
    },
    "overrides": [
        {
            "files": [
                "**/*.less"
            ],
            "rules": {
                "plugin/no-unsupported-browser-features": [
                    true,
                    {
                        "browsers": [
                            "extends browserslist-config-wikimedia/modern",
                            "not Safari < 16",
                            "not ios_saf < 16"
                        ],
                        "severity": "warning",
                        "ignore": [
                            "mdn-text-decoration-shorthand",
                            "text-decoration",
                            "css-nesting"
                        ],
                        "ignorePartialSupport": true
                    }
                ]
            }
        },
        {
            "files": [
                "resources/ext.ubuntu.styles/components/ubuntu/**/*.less"
            ],
            "rules": {
                "selector-class-pattern": "^ubuntu-"
            }
        }
    ]
}
