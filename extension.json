{
    "name": "UbuntuWiki",
    "version": "1.0.0",
    "author": "Ubuntu Developers",
    "url": "https://github.com/ubuntu/ubuntu-mediawiki-extension",
    "descriptionmsg": "ubuntu-ext-desc",
    "namemsg": "ubuntu-ext-name",
    "license-name": "GPL-3.0",
    "type": "other",
    "requires": {
        "MediaWiki": ">= 1.46"
    },
    "MessagesDirs": {
        "UbuntuWiki": [
            "i18n"
        ]
    },
    "AutoloadNamespaces": {
        "MediaWiki\\Extension\\UbuntuWiki\\": "src/"
    },
    "HookHandlers": {
        "main": {
            "class": "MediaWiki\\Extension\\UbuntuWiki\\Hooks",
            "services": [
                "MainConfig",
                "LinkRenderer"
            ]
        }
    },
    "Hooks": {
        "BeforePageDisplay": "main",
        "SkinAddFooterLinks": "main"
    },
    "ResourceModules": {
        "ext.ubuntu.codeBlock": {
            "packageFiles": [
                "ext.ubuntu.codeBlock/codeBlock.js"
            ],
            "messages": [
                "ubuntu-codeblock-copy",
                "ubuntu-codeblock-copied",
                "ubuntu-codeblock-copy-captcha-command"
            ]
        },
        "ext.ubuntu.styles": {
            "styles": [
                "ext.ubuntu.styles/common.less"
            ],
            "skinStyles": {
                "ubuntu": [
                    "ext.ubuntu.styles/common.less"
                ],
                "vector": [
                    "ext.ubuntu.styles/common.less"
                ],
                "vector-2022": [
                    "ext.ubuntu.styles/common.less"
                ],
                "minerva": [
                    "ext.ubuntu.styles/common.less"
                ]
            }
        },
        "zzz.ext.ubuntu.styles.minerva": {
            "styles": [
                "ext.ubuntu.styles.minerva/minerva.less"
            ],
            "skinStyles": {
                "minerva": [
                    "ext.ubuntu.styles.minerva/minerva.less"
                ]
            },
            "skins": [
                "minerva"
            ]
        },
        "zzz.ext.ubuntu.styles.vector": {
            "styles": [
                "ext.ubuntu.styles.vector/vector.less"
            ],
            "skinStyles": {
                "default": [
                    "ext.ubuntu.styles.vector/vector.less"
                ],
                "ubuntu": [
                    "ext.ubuntu.styles.vector/vector.less"
                ],
                "vector": [
                    "ext.ubuntu.styles.vector/vector.less"
                ],
                "vector-2022": [
                    "ext.ubuntu.styles.vector/vector.less"
                ]
            },
            "skins": [
                "ubuntu",
                "vector",
                "vector-2022"
            ]
        },
        "ext.ubuntu.cookieConsent": {
            "styles": [
                "ext.ubuntu.cookieConsent/vendor/cookie-policy.css"
            ],
            "noflip": true,
            "packageFiles": [
                "ext.ubuntu.cookieConsent/cookieConsent.js",
                "ext.ubuntu.cookieConsent/cookieConsent-vendor.js",
                "ext.ubuntu.cookieConsent/vendor/cookie-policy.js",
                {
                    "name": "ext.ubuntu.cookieConsent/config.json",
                    "config": [
                        "UbuntuCookieConsentEnabled"
                    ]
                }
            ],
            "messages": [
                "ubuntu-manage-trackers-button-label"
            ]
        }
    },
    "ResourceFileModulePaths": {
        "localBasePath": "resources",
        "remoteExtPath": "UbuntuWiki/resources"
    },
    "config": {
        "UbuntuCookieConsentEnabled": {
            "value": false,
            "description": "Enable the Canonical cookie-policy consent banner."
        },
        "UbuntuGTMContainerID": {
            "value": "",
            "description": "Google Tag Manager container ID (e.g. GTM-XXXXXX). Empty or whitespace-only disables GTM injection entirely. When the cookie consent banner is also enabled, gtag consent defaults are set to denied before GTM initialises."
        },
        "UbuntuFooterLinks": {
            "value": {
                "legal": "https://canonical.com/legal",
                "privacy": "https://canonical.com/legal/data-privacy",
                "codeofconduct": "https://ubuntu.com/community/docs/ethos/code-of-conduct",
                "disclaimers": null
            },
            "description": "Footer link targets (name => wiki page title or external URL), rendered in map order. The 'privacy' name replaces the default privacy link (added as an extension-owned item so its position follows the map order); the default 'disclaimers' link is blanked out. Set a name to null to drop the link; labels come from the ubuntu-footer-<name>-desc messages.",
            "merge_strategy": "array_replace"
        }
    },
    "manifest_version": 2
}
